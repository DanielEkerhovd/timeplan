{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/w/:slug([A-Za-z0-9_]{6,20}).png",
      "destination": "https://xdeujhmopwpaerwsczlu.supabase.co/functions/v1/share-image/:slug.png"
    },
    {
      "source": "/w/:slug([A-Za-z0-9_]{6,20})",
      "destination": "https://xdeujhmopwpaerwsczlu.supabase.co/functions/v1/share/:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
