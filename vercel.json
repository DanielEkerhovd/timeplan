{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/w/:slug([A-Za-z0-9_]{6,20}).png",
      "destination": "/api/img/:slug"
    },
    {
      "source": "/w/:slug([A-Za-z0-9_]{6,20})",
      "destination": "/api/w/:slug"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
