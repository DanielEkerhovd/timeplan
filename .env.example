# Kopier til .env.local og fyll inn fra Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Discord-bot (bare på serveren: Vercel → Environment Variables, aldri VITE_) ---
# Fra discord.com/developers/applications → appen Supabase alt bruker til innlogging.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=            # General Information → Public Key
DISCORD_BOT_TOKEN=             # Bot → Reset Token
DISCORD_CLIENT_SECRET=         # OAuth2 → Client Secret (samme som i Supabase)
DISCORD_STATE_SECRET=          # lang tilfeldig streng: openssl rand -hex 32
DISCORD_CRON_SECRET=           # lang tilfeldig streng, den samme i pg_cron-jobben
SUPABASE_SERVICE_ROLE_KEY=     # Project Settings → API → service_role. Aldri i klienten.
APP_URL=https://www.gatherapp.gg
